DB_PASSWORD=change_me
JWT_SECRET=change_me

# HTTPS production URLs (after running ssl-init.sh)
API_URL=https://washly.duckdns.org/api
WS_URL=wss://washly.duckdns.org/api
CUSTOMER_APP_URL=https://washly.duckdns.org

# HTTP (plain, no SSL — for local dev or before cert is set up)
# API_URL=http://150.230.53.189:3000
# WS_URL=ws://150.230.53.189:3000/ws
# CUSTOMER_APP_URL=http://150.230.53.189

# SMTP — for password reset emails (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Washly <your@gmail.com>
